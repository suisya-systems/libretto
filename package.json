{
  "name": "libretto",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "host",
    "page"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings host/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "verify:live": "npm run build && node --experimental-strip-types --no-warnings host/scripts/verify-live.ts",
    "verify:sandbox": "node --experimental-strip-types --no-warnings host/scripts/sandbox-live.ts",
    "verify:isolation": "node --experimental-strip-types --no-warnings host/scripts/sandbox-live.ts --model --probe --record",
    "measure": "node --experimental-strip-types --no-warnings host/scripts/measure.ts",
    "verify:fetch": "node --experimental-strip-types --no-warnings host/scripts/fetch-live.ts",
    "verify:files": "node --experimental-strip-types --no-warnings host/scripts/files-live.ts",
    "verify:meet": "node --experimental-strip-types --no-warnings host/scripts/meet-check.ts",
    "dev": "vite page",
    "dev:host": "node --env-file=page/dev.env --experimental-strip-types --no-warnings host/src/index.ts",
    "build": "vite build page"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
